#!/usr/bin/env bash
# rp — control Understudy from anywhere.
#
#   Usage: rp <command> [args]
#   Install globally (optional):
#     ln -s "$(pwd)/rp" "$PREFIX/bin/rp"     # Termux
#     sudo ln -s "$(pwd)/rp" /usr/local/bin/rp
#
#   rp start | stop | restart | status
#   rp log [n] | rp last [n]
#   rp setup | rp character | rp config
#   rp persona ... | rp contacts ... | rp mood ...
#   rp voice "..." | rp sticker ...
#   rp reset <id|all> [--mood] [--all]
#   rp test | rp turing | rp bench | rp number | rp boot

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
DIR="$(cd "$(dirname "$SELF")" && pwd)"
US_DIR="${UNDERSTUDY_DIR:-$DIR}"

if [ ! -d "$US_DIR" ]; then
  echo "understudy not found at: $US_DIR"
  exit 1
fi
cd "$US_DIR" || exit 1

cmd="${1:-status}"
[ $# -gt 0 ] && shift

case "$cmd" in
  start)    ./start.sh ;;
  stop)     ./stop.sh ;;
  restart)  ./restart.sh ;;
  status|st) ./status.sh ;;
  dash|dashboard)
    PORT="$(grep -E '^DASHBOARD_PORT=' .env 2>/dev/null | cut -d= -f2)"
    PORT="${PORT:-8787}"
    URL="http://127.0.0.1:$PORT/"
    echo "Dashboard: $URL"
    if command -v termux-open >/dev/null 2>&1; then termux-open "$URL" >/dev/null 2>&1 || true; fi
    ;;
  log|logs|tail)
    echo "following $US_DIR/rp.log — Ctrl+C to exit"
    tail -n "${1:-30}" -f rp.log ;;
  last)
    grep -av '█\|▄' rp.log 2>/dev/null | grep -aE '←|→|ignored|failed' | tail -n "${1:-10}" ;;
  persona|p)  node scripts/persona.mjs "$@" ;;
  contacts|c) node scripts/contacts.mjs "$@" ;;
  mood|m)     node scripts/mood.mjs "$@" ;;
  reset)      node scripts/reset.mjs "$@" ;;
  voice|vn)   node scripts/voice.mjs "$@" ;;
  sticker|st) node scripts/sticker.mjs "$@" ;;
  setup|connect)  node scripts/setup.mjs ;;
  character|char) node scripts/character.mjs "$@" ;;
  config|setting) node scripts/config.mjs "$@" ;;
  test)       node scripts/selftest.mjs ;;
  stats|biaya) node scripts/stats.mjs ;;
  doctor|cek)
    node scripts/doctor.mjs ;;
  watchdog|wd)
    if pgrep -f "watchdog.sh" >/dev/null 2>&1; then
      echo "watchdog already running (pid $(cat data/watchdog.pid 2>/dev/null))"
    else
      setsid ./watchdog.sh >/dev/null 2>&1 < /dev/null &
      sleep 1
      echo "watchdog started (pid $(cat data/watchdog.pid 2>/dev/null))"
    fi ;;
  turing|tt)  node scripts/turing.mjs ;;
  bench)      node scripts/bench.mjs ;;
  sync|push)
    if [ ! -d .git ]; then
      echo "not a git repository — run: git init -b main && git add -A && git commit -m init"
      exit 1
    fi
    git add -A
    if git diff --cached --quiet; then
      echo "nothing to commit"
      exit 0
    fi
    git commit -m "update: $(date '+%Y-%m-%d %H:%M')"
    git push
    ;;
  number|num)
    n="$(grep -a 'connected as' rp.log 2>/dev/null | tail -1 | sed 's/.*as //')"
    echo "${n:-unknown (never connected)}" ;;
  boot)  ./install-boot.sh ;;
  dir)   echo "$US_DIR" ;;
  edit)
    f="${1:-.env}"
    [ -f "$f" ] || { echo "no such file: $f"; exit 1; }
    ${EDITOR:-vi} "$f" ;;
  help|-h|--help)
    sed -n '2,15p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *)
    echo "unknown command: $cmd"; echo "run: rp help" ;;
esac
