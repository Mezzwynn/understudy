#!/usr/bin/env bash
# rp — control the Understudy WhatsApp roleplay agent from anywhere.
#
#   rp start | stop | restart | status
#   rp log [n]        follow the log (Ctrl+C to exit)
#   rp last [n]       recent in/out messages
#   rp persona ...    list | use <name> | new <name>
#   rp contacts ...   list | show | set name/nick/persona | reset
#   rp sticker ...    add stickers (--generate "prompt" name)
#   rp setup          connect a model (API key)
#   rp character      create a character (guided by the model)
#   rp config         behaviour settings (auto / manual)
#   rp mood ...       list | show <jid> | set <jid> <key> <value> | nudge <jid> <event>
#   rp test           lint + reply-path smoke test + offline selftest
#   rp lint           static check: identifiers used but never imported
#   rp smoke [--live] reply path end to end with a fake socket
#   rp voice "..."    generate a voice note (preview)
#   rp number         show the linked WhatsApp number
#   rp sync           git commit + push (GitHub)
#   rp dash           open the local web dashboard
#   rp stats          quota + usage
#   rp doctor         health check (keys, quota, dependencies)
#   rp watchdog       keep the bot alive (auto-restart + notification)
#   rp routine ...    today | --new | --history | --at HH:MM
#   rp boot           install auto-start on reboot

US_DIR="${UNDERSTUDY_DIR:-$DIR}"

if [ ! -d "$US_DIR" ]; then
  echo "understudy not found at: $US_DIR"
  echo "set UNDERSTUDY_DIR=/path/to/understudy"
  exit 1
fi

cd "$US_DIR" || exit 1

cmd="${1:-status}"
[ $# -gt 0 ] && shift

case "$cmd" in
  routine|rout)  node scripts/routine.mjs "${@:2}" ;;
  smoke)    node scripts/smoke.mjs "${@:2}" ;;
  lint)     node scripts/lint.mjs "${@:2}" ;;
  start)    ./start.sh ;;
  stop)     ./stop.sh ;;
  restart)  ./restart.sh ;;
  status|st) ./status.sh ;;
  dash|dashboard)
    PORT="$(grep -E '^DASHBOARD_PORT=' .env 2>/dev/null | cut -d= -f2)"
    PORT="${PORT:-8787}"
    URL="http://127.0.0.1:$PORT/"
    echo "Dashboard: $URL"
    if command -v termux-open >/dev/null 2>&1; then termux-open "$URL" >/dev/null 2>&1 || true; fi
    ;;
  log|logs|tail)
    echo "following $US_DIR/rp.log — Ctrl+C to exit"
    tail -n "${1:-30}" -f rp.log ;;
  last)
    grep -av '█\|▄' rp.log 2>/dev/null | grep -aE '←|→|ignored|failed' | tail -n "${1:-10}" ;;
  persona|p)
    node scripts/persona.mjs "$@" ;;
  setup|connect)  node scripts/setup.mjs ;;
  character|char) node scripts/character.mjs "$@" ;;
  config|setting) node scripts/config.mjs "$@" ;;
  contacts|c)
    node scripts/contacts.mjs "$@" ;;
  sticker|stiker)
    node scripts/sticker.mjs "$@" ;;
  mood|m)
    node scripts/mood.mjs "$@" ;;
  test|selftest)
    echo "── 1. static checks ──"
    node scripts/lint.mjs || exit 1
    node scripts/lint-dom.mjs || exit 1
    echo "── 2. reply path (fake socket, no model calls) ──"
    node scripts/smoke.mjs || exit 1
    echo "── 3. offline brain ──"
    node scripts/selftest.mjs ;;
  stats|biaya)
    node scripts/stats.mjs ;;
  doctor|cek)
    node scripts/doctor.mjs ;;
  watchdog|wd)
    if pgrep -f "watchdog.sh" >/dev/null 2>&1; then
      echo "watchdog already running (pid $(cat data/watchdog.pid 2>/dev/null))"
    else
      setsid ./watchdog.sh >/dev/null 2>&1 < /dev/null &
      sleep 1
      echo "watchdog started (pid $(cat data/watchdog.pid 2>/dev/null))"
    fi ;;
  voice|vn)
    node scripts/voice.mjs "$@" ;;
  turing|tt)
    node scripts/turing.mjs ;;
  bench)
    node scripts/bench.mjs ;;
  reset)
    node scripts/reset.mjs "$@" ;;
  sync|push)
    if [ ! -d .git ]; then
      echo "not a git repository — run: git init -b main && git add -A && git commit -m init"
      exit 1
    fi
    git add -A
    if git diff --cached --quiet; then
      echo "nothing to commit"
      exit 0
    fi
    git commit -m "update: $(date '+%Y-%m-%d %H:%M')"
    git push
    ;;
  number|num)
    n="$(grep -a 'connected as' rp.log 2>/dev/null | tail -1 | sed 's/.*as //')"
    echo "${n:-unknown (never connected)}" ;;
  boot)
    ./install-boot.sh ;;
  dir)
    echo "$US_DIR" ;;
  edit)
    f="${1:-.env}"
    [ -f "$f" ] || { echo "no such file: $f"; exit 1; }
    ${EDITOR:-vi} "$f" ;;
  help|-h|--help)
    sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)
    echo "unknown command: $cmd"
    echo "run: rp help" ;;
esac
