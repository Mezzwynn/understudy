# ─────────────────────────────────────────────────────────────
#  Understudy configuration
#  Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
#  Everything here has a sane default — you can start with just the keys.
# ─────────────────────────────────────────────────────────────

# ── Character ────────────────────────────────────────────────
BOT_NAME=Character
PERSONA=character

# ── Who may talk to the bot ──────────────────────────────────
# E.164 numbers, comma separated. EMPTY = every DM gets a reply.
# Groups are always blocked unless ALLOW_GROUPS=true.
ALLOW=
ALLOW_GROUPS=false
GROUP_ALLOW=
# WhatsApp sometimes delivers DMs from a LID instead of the phone number.
# Map them so the bot knows the real number:  LID_MAP=<lid>:<+number>
LID_MAP=

# ── Texting feel ─────────────────────────────────────────────
MAX_BUBBLES=4
BUBBLE_MAX_CHARS=320
MIN_TYPING_MS=900
MAX_TYPING_MS=4500
DEBOUNCE_MS=1800              # batch: tunggu diam selama ini sebelum membalas
DEBOUNCE_MAX_MS=12000         # batch: maksimal menunggu sejak pesan pertama (ms)
READ_MIN_MS=600               # waktu baca pesan (ms)
READ_MAX_MS=4000
PRETYPE_MIN_MS=1500           # jeda setelah dibaca, SEBELUM indikator "mengetik" muncul
PRETYPE_MAX_MS=9000
TYPING_PAUSE_CHANCE=0.25      # peluang berhenti mengetik sebentar di tengah
MARK_READ=true

# ── Human imperfections ──────────────────────────────────────
SKIP_CHANCE=0.06            # chance to read but not reply (short pings)
LONG_DELAY_CHANCE=0.1       # chance to answer after a distracted pause
LONG_DELAY_MIN_MS=25000
LONG_DELAY_MAX_MS=150000
TYPO_CHANCE=0.2
CORRECTION_CHANCE=0.35      # of typos, self-correct on the next line
REACTION_CHANCE=0.12        # sometimes an emoji reaction is the whole reply
BURST_CHANCE=0.18           # split one message into a 2-bubble burst

# ── Read receipts & quoting ──────────────────────────────────
READ_DELAY_MIN_MS=2500
READ_DELAY_MAX_MS=90000
QUOTE_CHANCE=0.2

# ── Texting first (proactive) ────────────────────────────────
PROACTIVE=true
PROACTIVE_IDLE_MIN=30
PROACTIVE_GAP_MIN=90
PROACTIVE_CHANCE_PER_TICK=0.15
PROACTIVE_WINDOWS=
PROACTIVE_SCHEDULE=
SCHEDULE_GRACE_MIN=20
SCHEDULE_JITTER_MIN=0
# chat_schedule mendukung dua format: "12:30" (menit tetap) atau "11,12,13" (menit dinamis per hari)
PROACTIVE_TICK_SEC=60
NUDGE_AFTER_MIN=8
DRY_AFTER_MIN=5
DRY_SILENT_AFTER=4
# jam kerja KAMU — dipakai biar pertanyaannya pas waktunya (mis. jangan
# nanya "lagi ngapain" pas kamu kerja)
USER_WORK_HOURS=9-17

QUIET_START=2               # no proactive messages between these hours
QUIET_END=8

# ── Context ──────────────────────────────────────────────────
HISTORY_TURNS=30
SUMMARIZE_AT=45

# ── PRIMARY model (the character) ────────────────────────────
# Any OpenAI-compatible endpoint. Examples:
#   Gemini direct : https://generativelanguage.googleapis.com/v1beta/openai
#   DeepSeek      : https://api.deepseek.com/v1
#   OpenRouter    : https://openrouter.ai/api/v1
#   OpenAI        : https://api.openai.com/v1
LLM_LABEL=primary
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=1.0
LLM_MAX_TOKENS=700
LLM_FREQ_PENALTY=0
LLM_PRESENCE_PENALTY=0

# ── FALLBACK model (optional) ────────────────────────────────
FALLBACK_LABEL=fallback
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=
FALLBACK_TEMPERATURE=1.3

# ── Mood/memory tracker (keep on a reliable JSON model) ──────
TRACKER_LABEL=tracker
TRACKER_BASE_URL=
TRACKER_API_KEY=
TRACKER_MODEL=
TRACKER_TEMPERATURE=0.2

# ── Eval judge (for `rp turing` / `rp bench`) ────────────────
JUDGE_LABEL=judge
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_TEMPERATURE=0.2

# ── Media in: photo description + voice-note transcription ───
GEMINI_API_KEY=
VISION_MODEL=gemini-2.5-flash

# ── Media out: voice notes (Ogg/Opus PTT) ────────────────────
# auto = ElevenLabs when a key is set, otherwise Gemini
TTS_PROVIDER=auto
VOICE_CHANCE=0.25
VOICE_MAX_CHARS=240

# ElevenLabs (preferred). It has a character quota, so ELEVENLABS_DAILY_CHARS
# stops the bot from burning it all in one day.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_FORMAT=opus_48000_64
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.15
ELEVENLABS_DAILY_CHARS=700

# Google Gemini TTS (fallback / alternative)
TTS_MODEL=gemini-2.5-flash-preview-tts

# ── Media out: photos & stickers ─────────────────────────────
IMAGE_MODEL=gemini-2.5-flash-image
PHOTO_CHANCE=0.05
PHOTO_DAILY_MAX=6
PHOTO_GLOBAL_DAILY_MAX=30
STICKER_CHANCE=0.08

# ── OpenRouter key (only needed for `rp bench`) ──────────────
OPENROUTER_API_KEY=

# ── Misc ─────────────────────────────────────────────────────
DEBUG=false                 # true = log full conversations to rp.log

# show as online only during her active hours
PRESENCE=true
# if they send a voice note, how often she answers with one
VOICE_MIRROR_CHANCE=0.7

# ── Dashboard web lokal ───────────────────────────────────
DASHBOARD=true
DASHBOARD_PORT=8787
# DASHBOARD_HOST=0.0.0.0 + DASHBOARD_TOKEN=... kalau mau diakses dari HP lain
DASHBOARD_HOST=127.0.0.1
DASHBOARD_TOKEN=
